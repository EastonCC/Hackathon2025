PORT=3000
JWT_SECRET=your-secret-key-change-this-in-production
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration
# For Supabase PostgreSQL (cloud database - allows data sharing between users):
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_ID:YOUR_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres
#
# For local SQLite (leave DATABASE_URL commented out for local-only database):
# (no configuration needed - uses database.sqlite file)

# Supabase (optional - only needed if using Supabase features directly)
# SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key
